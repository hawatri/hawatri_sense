[Unit]
Description=HawatriSense by Hawatri - load hawatri_sense and grant the hawatri_sense group access
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=modprobe hawatri_sense
ExecStart=systemd-tmpfiles --create hawatri_sense.conf
ExecStop=rmmod hawatri_sense

[Install]
WantedBy=multi-user.target
